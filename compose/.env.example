# .env.example — copy to .env on the VM (chmod 600) and fill in.
# Version pins are resolved at deploy time by scripts/resolve-versions.sh
# (queries registries for newest stable patch tags, then pins exactly).

LAN_IP=10.10.10.41

# --- Tier 1 data ---
POSTGRES_VERSION=          # e.g. 17.6-trixie
POSTGRES_USER=intelhub
POSTGRES_PASSWORD=         # random
POSTGRES_DB=intelhub

REDIS_VERSION=             # e.g. 7.4.5-alpine
REDIS_PASSWORD=            # random

NEO4J_VERSION=             # e.g. 5.26.12-community
NEO4J_PASSWORD=            # random

QDRANT_VERSION=            # e.g. v1.15.4

# --- Tier 2 sensors ---
SEARXNG_VERSION=           # e.g. 2025.9.18-abc1234
CRAWL4AI_VERSION=          # e.g. 0.7.4
CRAWL4AI_API_TOKEN=        # random

SPIDERFOOT_IMAGE=          # resolved at deploy (repo:tag or repo@digest)
HUGINN_REF=                # e.g. @sha256:... (digest-pinned)
HUGINN_DB_PASSWORD=        # random

# === SP4: Crucix + observability stack ===
CRUCIX_IMAGE=crucix:sha-3db7068
PROMETHEUS_VERSION=v3.14.0
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=v0.55.1
GRAFANA_VERSION=13.2.1
GRAFANA_ADMIN_PASSWORD=__GENERATE_STRONG__
# Crucix source keys + LLM live in compose/.env.crucix (see .env.crucix.example)
