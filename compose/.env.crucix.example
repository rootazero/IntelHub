# .env.crucix — Crucix container environment (VM-only, NEVER commit; deployed manually)
# Copy this template to compose/.env.crucix on the VM and fill in.
# All sources without keys degrade gracefully (Q1=A: no-key sources enabled).

# === OSINT Source API Keys (optional — fill later per Q1=A) ===
FRED_API_KEY=
FIRMS_MAP_KEY=
EIA_API_KEY=
AISSTREAM_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=
CLOUDFLARE_API_TOKEN=

# === LLM Layer (build-time patched to T8star relay; Q4b) ===
# LLM_PROVIDER=openai works because the image was built with the base-URL
# patch (scripts/build-crucix.sh) pointing at https://ai.t8star.org/v1.
LLM_PROVIDER=openai
LLM_API_KEY=__T8STAR_KEY__
LLM_MODEL=gpt-4.1-mini

# === Telegram Alerts (optional, requires LLM) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
