{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // Matches vite.config.ts resolve.alias — bare `gev-engine/...` specifiers
      // resolve here for tsc; typing comes from the ambient wildcard
      // declaration in src/gev-boot/gev-engine.d.ts (shorthand `any`).
      "gev-engine/*": ["./gev-engine/*"]
    },
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
