[
  {
    "name": "acknowledge_alert",
    "description": "Acknowledge an open alert.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "alert_id": {
          "description": "Alert UUID",
          "type": "string"
        }
      },
      "required": [
        "alert_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "crawl_url",
    "description": "Crawl a URL via Crawl4AI and ingest it as evidence (normalized, deduplicated, provenance-tracked). Returns document_id and dedupe status. When `await_embed=true`, blocks up to 30s for the embed worker to finish so a follow-up semantic_search returns this document.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "await_embed": {
          "description": "If true (default false), block up to 30s waiting for the embed worker\nto finish this document so a follow-up semantic_search returns it.\nReturns `embedding_status` and `embed_waited_ms` in the response.\nWhen `embed=skip`, this flag is ignored.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "embed": {
          "description": "Embedding decision (§40): \"auto\" (default, decision rules) | \"force\" | \"skip\"",
          "type": [
            "string",
            "null"
          ]
        },
        "investigation_id": {
          "description": "Optional investigation UUID to attach the crawl task to",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "URL to crawl and ingest as evidence",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_claim",
    "description": "Create a claim bound to evidence (§43: at least one evidence document REQUIRED). Optionally links entities (created if missing). Level 2 governed.",
    "inputSchema": {
      "$defs": {
        "ClaimEntityRefArgs": {
          "properties": {
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "description": "subject|object|mentioned (default mentioned)",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entities": {
          "description": "Entities the claim is about (created if missing)",
          "items": {
            "$ref": "#/$defs/ClaimEntityRefArgs"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "evidence_document_ids": {
          "description": "§43: at least one evidence document UUID is REQUIRED",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "Claim text (8–4000 chars)",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_document_ids"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_entity",
    "description": "Create an entity in the intelligence graph (typed intent → schema validation → PG canonical + Neo4j relationship memory). Level 2 governed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "aliases": {
          "description": "Optional aliases (max 10)",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "attributes": {
          "description": "Optional attributes (allowlist: description,url,country,confidence,severity,first_seen,last_seen,tags,source)"
        },
        "kind": {
          "description": "person|org|domain|ip|location|event|infrastructure|software|handle|email|phone|crypto_wallet",
          "type": "string"
        },
        "name": {
          "description": "Entity name (normalized)",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_finding",
    "description": "Create an agent finding bound to evidence (directive §28/§29: claims must cite supporting/contradicting evidence; findings are agent inference, never presented as verified fact).",
    "inputSchema": {
      "$defs": {
        "EvidenceLink": {
          "properties": {
            "document_id": {
              "description": "Document UUID supporting/contradicting the finding",
              "type": "string"
            },
            "relation": {
              "description": "\"supports\" (default) or \"contradicts\"",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "document_id"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "claim_text": {
          "description": "The claim text (agent inference — NOT verified fact, directive §29)",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence links — at least one required",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "type": "array"
        },
        "investigation_id": {
          "description": "Investigation UUID this finding belongs to",
          "type": "string"
        },
        "task_id": {
          "description": "Optional task UUID to attribute",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Short finding title",
          "type": "string"
        }
      },
      "required": [
        "investigation_id",
        "title",
        "claim_text",
        "evidence"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_investigation",
    "description": "Create a new investigation (first-class object: target/question/hypothesis).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "hypothesis": {
          "description": "Initial hypothesis",
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "description": "The question this investigation answers",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "The target (person/org/domain/event/...)",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Investigation title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_relationship",
    "description": "Create a typed relationship between two existing entities (endpoints must exist — create them first). Level 2 governed.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attributes": true,
        "from_kind": {
          "type": "string"
        },
        "from_name": {
          "type": "string"
        },
        "rel_type": {
          "description": "controls|owns|communicates_with|resolves_to|located_in|affiliated_with|uses|hosts|registered_by|related_to",
          "type": "string"
        },
        "to_kind": {
          "type": "string"
        },
        "to_name": {
          "type": "string"
        }
      },
      "required": [
        "from_kind",
        "from_name",
        "to_kind",
        "to_name",
        "rel_type"
      ],
      "type": "object"
    }
  },
  {
    "name": "fetch_document",
    "description": "Fetch a document by URL: returns the stored evidence if already collected, otherwise crawls and ingests it first.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "url": {
          "description": "Canonical or original URL to fetch (from store if present, else crawled fresh)",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    }
  },
  {
    "name": "financials_fetch",
    "description": "Fetch deep fundamentals for a US ticker via financialdatasets.ai (8 endpoints: profile/statements/segments/13F holders/insider KPI/guidance). Level 2 governed; responses are cached 30 days in Postgres (pay-per-request provider — a cache hit costs nothing).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "ticker": {
          "description": "US ticker, e.g. AAPL (financialdatasets.ai coverage: US equities)",
          "type": "string"
        }
      },
      "required": [
        "ticker"
      ],
      "type": "object"
    }
  },
  {
    "name": "find_contradicting_claims",
    "description": "Contradictions touching a claim (by claim_id) OR any claim about an entity (by entity_id). Exactly one must be supplied.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "claim_id": {
          "description": "Contradictions touching this claim UUID (mutually exclusive with entity_id)",
          "type": [
            "string",
            "null"
          ]
        },
        "entity_id": {
          "description": "Contradictions touching any claim about this entity UUID (mutually exclusive with claim_id)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "find_path",
    "description": "Find the shortest path between two entities in the knowledge graph. v2: temporal-aware, weighted by 1-confidence. Replaces v1 (no back-compat: v1 was unused in production).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "from": {
          "description": "Start entity name (case-insensitive exact match)",
          "type": "string"
        },
        "max_hops": {
          "description": "Maximum hops to expand (default 5, clamped 1..=8)",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "description": "Target entity name (case-insensitive exact match)",
          "type": "string"
        },
        "weighted": {
          "description": "Weight edges by 1 - confidence (sum), default true. false = raw hop count.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    }
  },
  {
    "name": "find_relationship_changes",
    "description": "Relationship changes between two entities (by name fragment, case-insensitive). Most recent first, optional time window.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "a": {
          "description": "Entity A name fragment",
          "type": "string"
        },
        "b": {
          "description": "Entity B name fragment",
          "type": "string"
        },
        "from": {
          "description": "ISO8601 lower bound (optional)",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "ISO8601 upper bound (optional)",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "a",
        "b"
      ],
      "type": "object"
    }
  },
  {
    "name": "find_supporting_claims",
    "description": "Claims that cite this entity, joined with documents that support them (supports-only by design; use find_contradicting_claims for the opposing half).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_id": {
          "description": "Entity UUID",
          "type": "string"
        },
        "limit": {
          "description": "Max results (default 50, max 100)",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    }
  },
