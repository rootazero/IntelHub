{
  "name": "create_relationship",
  "description": "Create a typed relationship between two existing entities (endpoints must exist — create them first). Level 2 governed.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "attributes": true,
      "from_kind": {
        "type": "string"
      },
      "from_name": {
        "type": "string"
      },
      "rel_type": {
        "description": "controls|owns|communicates_with|resolves_to|located_in|affiliated_with|uses|hosts|registered_by|related_to",
        "type": "string"
      },
      "to_kind": {
        "type": "string"
      },
      "to_name": {
        "type": "string"
      }
    },
    "required": [
      "from_kind",
      "from_name",
      "to_kind",
      "to_name",
      "rel_type"
    ],
    "type": "object"
  }
}