{
  "name": "query_entity",
  "description": "Query entities in the relationship graph by name (read-only, parameterized — no arbitrary Cypher).",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "kind": {
        "description": "Optional entity kind filter (person|org|domain|ip|location|event|...)",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Max results (default 20, max 100)",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "description": "Entity name (case-insensitive contains match)",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  }
}