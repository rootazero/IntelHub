# examples/intelhub.env.example — template for INTELHUB_ENV_FILE.
#
# Copy this file, uncomment the keys you have, fill in real values, then run:
#
#   curl -fsSL https://raw.githubusercontent.com/rootazero/IntelHub/main/scripts/install.sh \
#     | INTELHUB_ENV_FILE=$PWD/intelhub.env bash
#
#   # or for in-place updates:
#   curl -fsSL https://raw.githubusercontent.com/rootazero/IntelHub/main/scripts/install.sh \
#     | INTELHUB_ENV_FILE=$PWD/intelhub.env bash -s -- update
#
# Every key is OPTIONAL — leave commented or empty to skip. Skipping a key
# never aborts install/update; the corresponding feature degrades gracefully
# (e.g., empty EMBEDDING_API_KEY → semantic search falls back to keyword-only).
#
# This file is safe to commit. NEVER commit a file with real keys filled in.

# ------------------------------------------------------------ install-time --
# Affect install.sh / update.sh behavior. Read at script start.
#
# INTELHUB_HOME=/opt/intelhub          # install root (default ~/IntelHub)
# INTELHUB_LAN=10.10.10.0/24           # LAN CIDR for nftables
# INTELHUB_NONINTERACTIVE=1            # skip every interactive key prompt
# INTELHUB_TARBALL=https://example/intelhub.tar.gz  # install from tarball

# ----------------------------------------------------------- core/hub.env --
# Generated by install.sh step_secrets on first install. Manually
# pre-populating these rarely makes sense (LAN_IP etc. are auto-detected).

# HUB_LISTEN_ADDR=10.10.10.41:8800
# HUB_ADMIN_TOKEN=                   # 24-byte hex; install.sh generates one if empty

# --------------------------------------------- core/secrets.env (optional) --
# Each empty value degrades the named feature; nothing aborts install.
# See scripts/install.sh step_keys for the canonical prompt text + skip
# consequence for each key.

# EMBEDDING_API_KEY=sk-...            # T8star embedding relay; skip → keyword-only search
# FIRMS_MAP_KEY=                      # NASA FIRMS fire hotspots layer; skip → no fire layer
# ACLED_EMAIL=                        # ACLED conflict events email
# ACLED_PASSWORD=                     # ACLED conflict events password (OAuth password grant)
# RELIEFWEB_APPNAME=                  # ReliefWeb free appname (apidoc.reliefweb.int)
# FRED_API_KEY=                       # FRED macro series
# COMTRADE_API_KEY=                   # UN Comtrade trade flows
# BLS_API_KEY=                        # BLS labor/stats (US-residential-IP registration only)
# X_BEARER_TOKEN=                     # X/Twitter Basic ($200/mo, no free read)
# FMP_API_KEY=                        # Financial Modeling Prep quotes
# FINNHUB_API_KEY=                    # Finnhub news / insiders / earnings
# FINANCIALDATASETS_API_KEY=          # financialdatasets.ai financials_fetch
# EIA_API_KEY=                        # EIA energy data

# Alerts (Telegram push; leave empty for console-only alerts)
# HUB_ALERT_TELEGRAM_BOT_TOKEN=
# HUB_ALERT_TELEGRAM_CHAT_ID=

# ------------------------------------------- core/console-build.env (CARTO) --
# Console build-time only (Vite inlines at build). Never enters the repo tree.
#
# VITE_CARTO_KEY=                     # CARTO basemap key (carto.com/basemaps/apikey free)
                                      # skip → console falls back to Esri primary basemap

# ----------------------------------------- runtime feature flags (optional) --
# These get written into core/hub.env by install.sh but you can pre-set them
# here to flip defaults without editing the generated file later.
#
# HUB_RERANK_ENABLED=false            # cross-encoder rerank stage (T8star /v1/rerank)
# HUB_LLM_ENABLED=false               # LLM planner fallback for investigate()
# HUB_QUERY_CACHE_ENABLED=true        # Redis-backed query result cache (default on)
# HUB_QUERY_CACHE_TTL_SECS=300        # cache TTL in seconds
# HUB_EMBED_MIN_WORDS=50              # min words for embed eligibility (50 default)